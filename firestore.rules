rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper para verificar se o usuário logado tem um dos papéis administrativos ou de desenvolvedor
    function getRole() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data ? 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
    }
    
    function isAdmin() {
      return request.auth != null && (
        getRole() == 'owner' || 
        getRole() == 'manager' || 
        getRole() == 'developer'
      );
    }

    function isStaff() {
      return request.auth != null && (
        getRole() == 'staff' || isAdmin()
      );
    }
    
    // ---- Helpers da coleção de usuários ----
    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // O cargo resultante da escrita é igual ao cargo atual do documento?
    function sameRole() {
      return request.resource.data.get('role', null) == resource.data.get('role', null);
    }

    // Senhas NUNCA podem ser gravadas no Firestore (só o Firebase Authentication cuida delas).
    // Remover um campo legado de senha é permitido; criar ou alterar não.
    function writesSecret() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['password', 'tempPassword'])
        && request.resource.data.keys().hasAny(['password', 'tempPassword']);
    }

    function touchesIdentity() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email', 'authEmail']);
    }

    // Admin só gerencia contas de cargo inferior (developer: todas; owner: manager/staff/client; manager: staff/client).
    function canManageTarget() {
      return getRole() == 'developer'
        || (getRole() == 'owner' && resource.data.get('role', 'client') in ['manager', 'staff', 'client'])
        || (getRole() == 'manager' && resource.data.get('role', 'client') in ['staff', 'client']);
    }

    function roleChangeAllowed() {
      return sameRole()
        || getRole() == 'developer'
        || (getRole() == 'owner'
            && request.resource.data.get('role', 'client') in ['manager', 'staff', 'client']);
    }

    // Regras para a coleção de usuários
    match /users/{userId} {
      // Cada pessoa lê só o próprio documento; equipe e administradores leem os demais.
      allow get: if request.auth != null && (isSelf(userId) || isStaff());

      // Listagem (consultas): somente equipe/administradores. Nada de consulta sem login.
      allow list: if request.auth != null && isStaff();

      // Cliente cria apenas o próprio perfil, sempre como 'client'. Contas de equipe são criadas pelo servidor.
      allow create: if isSelf(userId)
        && request.resource.data.role == 'client'
        && request.resource.data.get('uid', userId) == userId
        && !request.resource.data.keys().hasAny(['password', 'tempPassword']);

      allow update: if request.auth != null && !writesSecret() && (
        // o próprio usuário: nunca altera o próprio cargo nem a identidade (uid/authEmail)
        (isSelf(userId) && sameRole() && request.resource.data.get('uid', userId) == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authEmail']))
        // equipe: só contas de clientes, sem mexer em cargo nem identidade
        || (isStaff() && !isSelf(userId) && resource.data.get('role', 'client') == 'client'
            && sameRole() && !touchesIdentity())
        // administradores: só cargos inferiores; ninguém altera o próprio cargo
        || (isAdmin() && !isSelf(userId) && canManageTarget() && roleChangeAllowed())
      );

      // Exclusão de contas é feita pelo servidor (remove também o login no Auth).
      allow delete: if false;
    }

    match /orders/{orderId} {
      // Ler pedidos: qualquer um que saiba o ID pode ler (ID é incognoscível), mas listar requer autenticação
      allow get: if true;
      allow list: if request.auth != null && (
        resource.data.clientUid == request.auth.uid || 
        isStaff()
      );
      
      // Criar pedido: usuário autenticado inserindo seu próprio uid como clientUid
      // O sistema Híbrido requer que usuários anônimos possam criar pedidos nesses status
      allow create: if 
        isStaff() ||
        (request.auth != null && request.resource.data.clientUid == request.auth.uid) ||
        (request.resource.data.status == 'awaiting_payment' || request.resource.data.status == 'pending' || request.resource.data.status == 'building_cart');
      
      // Atualizar pedido: staff/admin pode atualizar qualquer pedido. O próprio cliente só pode atualizar se o pedido ainda for dele
      // Também permite atualização via backend usando o token de verificação do pagamento (webhook)
      allow update: if 
        (('paymentVerificationToken' in resource.data && resource.data.paymentVerificationToken != null && request.resource.data.paymentVerificationToken == resource.data.paymentVerificationToken)) ||
        (request.auth != null && (
          isStaff() || 
          (resource.data.clientUid == request.auth.uid && request.resource.data.clientUid == request.auth.uid)
        )) ||
        request.resource.data.status == 'building_cart';
      
      // Excluir pedido: staff e admins
      allow delete: if isStaff();
    }

    // Regras para a coleção de produtos (products)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Regras para a coleção de configurações (settings)
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Regras para a coleção de câmeras de segurança (cameras)
    match /cameras/{cameraId} {
      allow read: if request.auth != null && (getRole() == 'owner' || getRole() == 'developer');
      allow write: if request.auth != null && getRole() == 'developer';
    }

    // Regras para a coleção de logs de auditoria (audit_logs)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Regras para a coleção de transações (transactions)
    match /transactions/{transactionId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // Carteira do proprietário: somente owner/developer
    match /wallet_config/{docId} {
      allow read, write: if request.auth != null && (getRole() == 'owner' || getRole() == 'developer');
    }
    match /wallet_entries/{entryId} {
      allow read, write: if request.auth != null && (getRole() == 'owner' || getRole() == 'developer');
    }
    match /wallet_withdrawals/{withdrawalId} {
      allow read, write: if request.auth != null && (getRole() == 'owner' || getRole() == 'developer');
    }

    // Regras para a coleção de reservas (reservations)
    match /reservations/{reservationId} {
      allow read: if true;
      allow write: if isStaff();
    }



    // Regras para a coleção de chats de suporte (support_chats)
    match /support_chats/{chatId} {
      allow read, write: if (request.auth != null && (request.auth.uid == chatId || isStaff()))
                          || chatId.matches('^visitante_.*');
    }

    // Regras para a coleção de regras de treinamento da I.A. (ai_rules)
    match /ai_rules/{ruleId} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
