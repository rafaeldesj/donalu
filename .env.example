# Variáveis das funções de servidor (Vercel -> Project Settings -> Environment Variables).
# NUNCA coloque valores reais neste arquivo nem faça commit deles.

# Conta de serviço do Firebase (JSON inteiro ou em base64). Necessária para login por telefone,
# gestão de contas e assistente. Gere em: Firebase Console -> Configurações -> Contas de serviço.
FIREBASE_SERVICE_ACCOUNT=

# Chave Web do Firebase (a mesma VITE_FIREBASE_API_KEY). Usada só no servidor para conferir senhas.
FIREBASE_WEB_API_KEY=

# Chave do Gemini (Google AI Studio). Fica SOMENTE no servidor.
GEMINI_API_KEY=

# Opcional: origens permitidas (CORS), separadas por vírgula. Vazio = qualquer origem.
ALLOWED_ORIGINS=
